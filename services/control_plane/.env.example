# CDM-OS Control Plane — Environment Variables
# Copy to .env and fill in real values

# Environment: development | staging | production
CDM_ENV=development
CDM_LOG_LEVEL=INFO
POLICY_MODE=enforce

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cdm_os_db
POSTGRES_USER=cdm_admin
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (JWT bearer tokens)
CDM_AUTH_ENABLED=false
CDM_JWT_SECRET=CHANGE_ME

# CORS — comma-separated allowed origins
CDM_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Tool Gateway
MCP_GATEWAY_URL=http://localhost:8080
GATEWAY_SERVICE_KEY=CHANGE_ME
