# CDM-OS Tool Gateway — Environment Variables
# Copy to .env and fill in real values

# ── General ──────────────────────────────────────────────
CDM_ENV=development          # development | staging | production
CDM_LOG_LEVEL=INFO
TOOL_GATEWAY_PORT=8080

# ── Service-to-service auth ─────────────────────────────
GATEWAY_SERVICE_KEY=CHANGE_ME
EXECUTION_GRANT_SECRET=CHANGE_ME

# ── Salesforce credentials (password flow) ──────────────
SF_USERNAME=CHANGE_ME
SF_PASSWORD=CHANGE_ME
SF_SECURITY_TOKEN=CHANGE_ME
SF_DOMAIN=login              # login | test
SF_LOGIN_URL=https://login.salesforce.com

# ── Salesforce credentials (JWT / connected-app flow) ───
SF_CONSUMER_KEY=
SF_PRIVATE_KEY_PATH=

# ── Salesforce org settings ─────────────────────────────
SF_ORG_TYPE=                 # sandbox | production | developer
SF_MOCK_MODE=false           # true only for local dev without a real org

# ── MCP client tuning ──────────────────────────────────
MCP_REQUEST_TIMEOUT_SEC=30
MCP_MAX_RETRIES=2

# ── Control plane URL (used by gateway httpx calls) ─────
CONTROL_PLANE_URL=http://localhost:8000
