# CDM-OS governance UI (apps/web) — copy to apps/web/.env.local

# Browser -> Control Plane. The UI calls <this>/api/v1/... directly, so this origin
# must be listed in the Control Plane's CDM_CORS_ORIGINS.
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8000

# Server-side only (Next.js API routes under /api/salesforce/*) -> Tool Gateway.
TOOL_GATEWAY_URL=http://localhost:8080
# Same value as the root .env. Read only on the server; never prefix with NEXT_PUBLIC_.
GATEWAY_SERVICE_KEY=replace-with-the-same-value-as-the-root-env

# Optional
# CONTROL_PLANE_URL=http://localhost:8000      # server-side health check override
# NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1   # full override incl. /api/v1
# NEXT_PUBLIC_WS_URL=                          # realtime updates (no backend route yet)
